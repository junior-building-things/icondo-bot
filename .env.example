# iCondo Login Credentials
ICONDO_EMAIL=your_email@example.com
ICONDO_PASSWORD=your_password

# Booking Preferences
# Preferred time slots in order of priority (24h format)
PREFERRED_TIMES=19:00,20:00

# Facility name (as it appears in iCondo)
FACILITY_NAME=Tennis Court

# How many days ahead to book (iCondo typically releases slots 7 or 14 days ahead)
DAYS_AHEAD=14

# Browser settings
HEADLESS=true

# Retry settings
MAX_RETRIES=3
RETRY_DELAY_MS=500
